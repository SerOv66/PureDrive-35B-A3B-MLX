diff --git a/omlx/patches/c35_attn_out.py b/omlx/patches/c35_attn_out.py
new file mode 100644
index 0000000..ab37e31
--- /dev/null
+++ b/omlx/patches/c35_attn_out.py
@@ -0,0 +1,71 @@
+# coder35b (K2): output glue of the Qwen3.5 full-attention layers in ONE launch instead of 3-4 (gate split copy, transpose
+# [1, H, L, D] -> [1, L, H*D], Sigmoid, Multiply). The gate is read in place from q_proj's output (row t, head h: the second
+# half of its 2*D slice). Arithmetic transcribed from MLX 0.32.3 Metal unary_ops.h Sigmoid and binary_ops.h Multiply on the
+# same type T, so the input of o_proj is bitwise the stock one (bench/attn_out_test.py).
+# Enabled with C35_ATTN_OUT=1 (applied from c35_gqa_attention.apply). Anything else keeps the original method.
+import logging
+
+logger = logging.getLogger(__name__)
+_PATCHED = False
+_KERNEL = {}
+_SEEN = set()
+MAX_ROWS = 64   # decode / verify / copy windows; prefill chunks keep the stock path
+
+_SOURCE = """
+    // one thread per output element (t, h, d) of [1, L, H * D]
+    const uint i = thread_position_in_grid.x;
+    const int t = int(i) / (H * D), h = (int(i) / D) % H, d = int(i) % D;
+    const int L = nrows[0];
+    T x = qo[size_t(t) * (H * 2 * D) + h * (2 * D) + D + d];
+    auto y = 1 / (1 + metal::precise::exp(metal::abs(x)));     // MLX Sigmoid (unary_ops.h)
+    T s = (x < 0) ? y : 1 - y;
+    out[i] = attn[(size_t(h) * L + t) * D + d] * s;             // MLX Multiply (binary_ops.h)
+"""
+
+
+def attn_out(attn, qo, hq, d):
+    """o_proj input [1, L, hq*d] = transpose(attn [1, hq, L, d]) * sigmoid(gate), gate = qo [1, L, hq*2d][..., d:2d per head]."""
+    import mlx.core as mx
+
+    if "k" not in _KERNEL:
+        _KERNEL["k"] = mx.fast.metal_kernel(name="c35_attn_out", input_names=["attn", "qo", "nrows"], output_names=["out"],
+                                            source=_SOURCE)
+    L = qo.shape[1]
+    return _KERNEL["k"](inputs=[attn, qo, mx.array([L], dtype=mx.int32)], template=[("T", qo.dtype), ("H", hq), ("D", d)],
+                        grid=(L * hq * d, 1, 1), threadgroup=(256, 1, 1), output_shapes=[(1, L, hq * d)],
+                        output_dtypes=[qo.dtype])[0]
+
+
+def apply():
+    global _PATCHED
+    if _PATCHED:
+        return True
+    import mlx.core as mx
+    from mlx_vlm.models.qwen3_5 import language as q35
+
+    orig = q35.Qwen3_5Attention.__call__
+
+    def __call__(self, x, mask=None, cache=None, position_ids=None, position_embeddings=None):
+        B, L, _ = x.shape
+        if B != 1 or L > MAX_ROWS or x.dtype != mx.bfloat16 or self.head_dim != 256:
+            return orig(self, x, mask, cache, position_ids, position_embeddings)
+        qo = self.q_proj(x)
+        queries, keys, values, gate, mask = self._prepare_projected_qkv(
+            qo, self.k_proj(x), self.v_proj(x), cache, position_ids, position_embeddings, mask)
+        # module globals looked up at call time: the c35 / chain-cache attention patches replace them
+        output = None
+        if isinstance(mask, str) and mask == "left_padded_decode":
+            mask = None
+            output = q35._qwen3_5_left_padded_attention(queries, keys, values, cache=cache, scale=self.scale, mask=mask)
+        if output is None:
+            output = q35.scaled_dot_product_attention(queries, keys, values, cache=cache, scale=self.scale, mask=mask)
+        if qo.dtype != mx.bfloat16 or output.dtype != qo.dtype or output.shape != (1, self.num_attention_heads, L, 256):
+            return self.o_proj(output.transpose(0, 2, 1, 3).reshape(B, L, -1) * mx.sigmoid(gate))
+        if L not in _SEEN:
+            _SEEN.add(L); logger.info("c35 fused attention output engaged (L=%d)", L)
+        return self.o_proj(attn_out(output, qo, self.num_attention_heads, 256))
+
+    q35.Qwen3_5Attention.__call__ = __call__
+    _PATCHED = True
+    logger.info("c35 fused attention output glue (transpose + sigmoid gate) patch applied")
+    return True
diff --git a/omlx/patches/c35_gqa_attention.py b/omlx/patches/c35_gqa_attention.py
new file mode 100644
index 0000000..efce3c0
--- /dev/null
+++ b/omlx/patches/c35_gqa_attention.py
@@ -0,0 +1,107 @@
+# coder35b: route Qwen3.5 full-attention decode (L=1) AND MTP verify/copy windows (L<=64, in 8-row blocks) through the row-exact GQA kernel
+# in <workspace>/bench/kernels/gqa_attn.py (K/V read once per step for all 8 q-heads of a kv head and all rows).
+# Enabled with C35_GQA_ATTN=1. Anything not batch-1 / hd256 / 16:2 / L<=64 / no array mask keeps the original path.
+import logging, os, sys
+
+logger = logging.getLogger(__name__)
+_PATCHED = False
+
+
+MAX_ROWS = 64   # longer row blocks (prefill chunks) keep the stock path in every mode
+
+
+def _eligible(q, k, mask):
+    return (q.ndim == 4 and q.shape[0] == 1 and q.shape[1] == 16 and q.shape[3] == 256 and 1 <= q.shape[2] <= MAX_ROWS
+            and k.shape[1] == 2 and k.shape[2] >= q.shape[2] and (mask is None or (isinstance(mask, str) and mask == "causal")))
+
+
+def _rows_attention(gqa_attention, q, k, v, scale):
+    """Row-exact for any row count: blocks of <= 8 rows, each against the keys its last row may see (bottom-right causal),
+    so every row is computed exactly as a one-row decode at its position (AUDIT EXP-030: 16-row copy windows)."""
+    L, N = q.shape[2], k.shape[2]
+    if L <= 8:
+        return gqa_attention(q, k, v, scale)
+    import mlx.core as mx
+    outs = []
+    for c0 in range(0, L, 8):
+        c1 = min(c0 + 8, L)
+        n = N - (L - c1)
+        outs.append(gqa_attention(q[:, :, c0:c1, :], k[:, :, :n, :], v[:, :, :n, :], scale))
+    return mx.concatenate(outs, axis=2)
+
+
+def apply():
+    global _PATCHED
+    if _PATCHED:
+        return True
+    ws = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..", ".."))
+    sys.path.insert(0, os.path.join(ws, "bench", "kernels"))
+    from gqa_attn import gqa_attention
+    from mlx_vlm.models.qwen3_5 import language as q35
+
+    orig_sdpa = q35.scaled_dot_product_attention
+    orig_verify = q35._qwen3_5_left_padded_attention
+    seen = set()
+    from collections import Counter
+    stats = Counter()
+    debug = os.environ.get("C35_GQA_DEBUG", "0") == "1"
+    mtp_window = int(os.environ.get("C35_MTP_WINDOW", "0"))
+
+    def note(seam, q, mask, cache, used):
+        if debug:
+            stats[(seam, q.shape[2], type(mask).__name__ if not isinstance(mask, str) else mask, type(cache).__name__, used)] += 1
+            if sum(stats.values()) % 200 == 0:
+                logger.info("c35 stats: %s", dict(stats))
+
+    def sdpa(queries, keys, values, cache=None, scale=1.0, mask=None, **kw):
+        ok = not kw and _eligible(queries, keys, mask) and getattr(cache, "left_padding", None) is None
+        note("sdpa", queries, mask, cache, ok)
+        if ok:
+            if queries.shape[2] not in seen:
+                seen.add(queries.shape[2]); logger.info("c35 GQA attention engaged (decode, L=%d)", queries.shape[2])
+            if mtp_window and getattr(cache, "_c35_mtp", False) and keys.shape[2] > mtp_window + queries.shape[2] - 1:
+                # draft-only: the MTP head (proposer) attends to its last C35_MTP_WINDOW positions; verify stays exact
+                n = mtp_window + queries.shape[2] - 1
+                keys, values = keys[:, :, -n:, :], values[:, :, -n:, :]
+            return _rows_attention(gqa_attention, queries, keys, values, scale)
+        return orig_sdpa(queries, keys, values, cache=cache, scale=scale, mask=mask, **kw)
+
+    def verify(queries, keys, values, *, cache, scale, mask):
+        ok = _eligible(queries, keys, mask) and getattr(cache, "left_padding", None) is None
+        note("verify", queries, mask, cache, ok)
+        if ok:
+            if -queries.shape[2] not in seen:
+                seen.add(-queries.shape[2]); logger.info("c35 GQA attention engaged (verify, L=%d)", queries.shape[2])
+            return _rows_attention(gqa_attention, queries, keys, values, scale)
+        return orig_verify(queries, keys, values, cache=cache, scale=scale, mask=mask)
+
+    if debug:
+        import traceback
+        import mlx.core as _mx
+        _orig_fast = _mx.fast.scaled_dot_product_attention
+        firsts = set()
+
+        def fast_sdpa(q, k, v, *a, **kw):
+            key = ("fast", q.shape[2] if q.shape[2] <= 8 else ">8", k.shape[2] > 8)
+            stats[key] += 1
+            if key not in firsts:
+                firsts.add(key)
+                st = [f"{f.filename.split('/')[-1]}:{f.lineno}:{f.name}" for f in traceback.extract_stack()[-7:-1]]
+                logger.info("c35 first %s q=%s k=%s stack=%s", key, q.shape, k.shape, " <- ".join(reversed(st)))
+            return _orig_fast(q, k, v, *a, **kw)
+        _mx.fast.scaled_dot_product_attention = fast_sdpa
+
+    q35.scaled_dot_product_attention = sdpa
+    # the batch-invariant speculative verifier calls base SDPA directly for 1-row forwards
+    from mlx_vlm.models.qwen3_5 import speculative_verifier as q35_sv
+    q35_sv.scaled_dot_product_attention = sdpa
+    q35._qwen3_5_left_padded_attention = verify
+    if os.environ.get("C35_QK_PREP", "0") == "1":   # EXP-093: fused q/k RMSNorm + M-RoPE (bitwise stock)
+        from .c35_qk_prep import apply as _qk_apply
+        _qk_apply()
+    if os.environ.get("C35_ATTN_OUT", "0") == "1":   # K2 (EXP-110): fused output glue (gate, transpose, sigmoid*mul), bitwise stock
+        from .c35_attn_out import apply as _ao_apply
+        _ao_apply()
+    _PATCHED = True
+    logger.info("c35 GQA row-exact attention patch applied")
+    return True
diff --git a/omlx/patches/c35_qk_prep.py b/omlx/patches/c35_qk_prep.py
new file mode 100644
index 0000000..013e6dc
--- /dev/null
+++ b/omlx/patches/c35_qk_prep.py
@@ -0,0 +1,142 @@
+# coder35b (EXP-093): q/k preparation of the Qwen3.5 full-attention layers in ONE launch instead of ~10
+# (q/k RMSNorm, transposes to [1, H, L, D], position ids, M-RoPE of the first 64 dims). Arithmetic transcribed from
+# MLX 0.32.3 rms_single_row (as c35_add_rms_norm) and mlx-vlm's fused MRoPE kernel (half-split pairing,
+# out = T(xv*c - xp*s) / T(xp*c + xv*s)), so the outputs are bitwise those of the stock ops (bench/qk_prep_test.py).
+# Enabled with C35_QK_PREP=1 (applied from c35_gqa_attention.apply). Anything else keeps the original method.
+# C35_QK_PREP_MAIN=1 (H28): also the main model, which always passes position_ids ([3, 1, L] or [1, L]): the kernel reads
+# them on device per M-RoPE section exactly as mlx-vlm's kernel (axis = position_selector[freq], strided, no copy), so any
+# position ids (text, image, rope delta) give the stock result; every fallback gets the caller's position_ids (AUDIT EXP-110 C1).
+import logging, os
+
+logger = logging.getLogger(__name__)
+_PATCHED = False
+_KERNEL = {}
+_SEEN = set()
+MAX_ROWS = 64   # decode / verify / copy windows; prefill chunks keep the stock path
+
+_SOURCE = """
+    // grid (64 * (HQ + HK) * L), threadgroup 64: one threadgroup per (row t, head h); h < HQ -> q head, else k head
+    const uint tg = threadgroup_position_in_grid.x;
+    const uint lid = thread_position_in_threadgroup.x;
+    const uint lane = thread_index_in_simdgroup;
+    const uint sgi = simdgroup_index_in_threadgroup;
+    const int L = nrows[0];
+    const int t = int(tg) / (HQ + HK), h = int(tg) % (HQ + HK);
+    const bool isq = h < HQ;
+    const device T* src = isq ? (qo + size_t(t) * (HQ * 2 * D) + h * (2 * D)) : (kp + size_t(t) * (HK * D) + (h - HQ) * D);
+    const device T* w = isq ? qw : kw;
+    threadgroup float local_inv_mean[1];
+    threadgroup float local_sums[32];
+    threadgroup T nrm[D];
+    // RMSNorm: MLX rms_single_row (D/4 threads, 4 values each, fp32 sum of squares, simd_sum + threadgroup sum)
+    float acc = 0;
+    float tx[4];
+    for (int i = 0; i < 4; i++) {
+        tx[i] = src[lid * 4 + i];
+        acc += tx[i] * tx[i];
+    }
+    acc = simd_sum(acc);
+    if (sgi == 0) local_sums[lane] = 0;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0) local_sums[sgi] = acc;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgi == 0) {
+        acc = simd_sum(local_sums[lane]);
+        if (lane == 0) local_inv_mean[0] = metal::precise::rsqrt(acc / axis_size[0] + eps[0]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int i = 0; i < 4; i++) nrm[lid * 4 + i] = w[lid * 4 + i] * static_cast<T>(tx[i] * local_inv_mean[0]);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // M-RoPE (mlx-vlm fused kernel, half-split pairs (f, f + HALF)), dims >= ROT copied
+    device T* dst = isq ? (q_out + (size_t(h) * L + t) * D) : (k_out + (size_t(h - HQ) * L + t) * D);
+    for (int i = 0; i < 4; i++) {
+        const int d = lid * 4 + i;
+        const int fi = d < HALF ? d : d - HALF;   // frequency index of the pair (f, f + HALF)
+        float pos;
+        if (PND == 0) pos = static_cast<float>(pids[0] + t);                        // cache offset
+        else if (PND == 2) pos = static_cast<float>(pids[t * pids_strides[1]]);     // [1, L]
+        else pos = static_cast<float>(pids[int(psel[fi]) * pids_strides[0] + t * pids_strides[2]]);   // [3, 1, L]
+        if (d < HALF) {
+            float angle = pos * static_cast<float>(inv_freq[d]);
+            float c = metal::cos(angle);
+            float s = metal::sin(angle);
+            float xv = static_cast<float>(nrm[d]);
+            float xp = static_cast<float>(nrm[d + HALF]);
+            dst[d] = static_cast<T>(xv * c - xp * s);
+        } else if (d < 2 * HALF) {
+            float angle = pos * static_cast<float>(inv_freq[d - HALF]);
+            float c = metal::cos(angle);
+            float s = metal::sin(angle);
+            float xv = static_cast<float>(nrm[d - HALF]);
+            float xp = static_cast<float>(nrm[d]);
+            dst[d] = static_cast<T>(xp * c + xv * s);
+        } else {
+            dst[d] = nrm[d];
+        }
+    }
+"""
+
+
+def qk_prep(q_proj_output, keys, q_norm, k_norm, inv_freq, positions, hq, hk, d, half, psel=None):
+    """(queries [1, hq, L, d], keys [1, hk, L, d]) normed and roped, as the stock ops of _prepare_projected_qkv.
+    positions: int cache offset, or the caller's position_ids [1, L] / [3, 1, L] (then psel = rotary position_selector)."""
+    import mlx.core as mx
+
+    if "k" not in _KERNEL:   # strided inputs: position_ids may be a broadcast view; the others are made contiguous below
+        _KERNEL["k"] = mx.fast.metal_kernel(
+            name="c35_qk_prep", input_names=["qo", "kp", "qw", "kw", "eps", "axis_size", "inv_freq", "pids", "psel", "nrows"],
+            output_names=["q_out", "k_out"], source=_SOURCE, ensure_row_contiguous=False)
+    L = q_proj_output.shape[1]
+    if isinstance(positions, mx.array):
+        pids, pnd = positions, positions.ndim
+    else:
+        pids, pnd = mx.array([positions], dtype=mx.int32), 0
+    if psel is None:
+        psel = mx.zeros((1,), dtype=mx.int32)
+    return _KERNEL["k"](
+        inputs=[mx.contiguous(q_proj_output), mx.contiguous(keys), mx.contiguous(q_norm.weight), mx.contiguous(k_norm.weight),
+                mx.array([q_norm.eps], dtype=mx.float32), mx.array([d], dtype=mx.uint32), mx.contiguous(inv_freq), pids,
+                mx.contiguous(psel), mx.array([L], dtype=mx.int32)],
+        template=[("T", q_proj_output.dtype), ("HQ", hq), ("HK", hk), ("D", d), ("HALF", half), ("PND", pnd)],
+        grid=(64 * (hq + hk) * L, 1, 1), threadgroup=(64, 1, 1),
+        output_shapes=[(1, hq, L, d), (1, hk, L, d)], output_dtypes=[q_proj_output.dtype, q_proj_output.dtype])
+
+
+def apply():
+    global _PATCHED
+    if _PATCHED:
+        return True
+    import mlx.core as mx
+    from mlx_vlm.models.qwen3_5 import language as q35
+
+    orig = q35.Qwen3_5Attention._prepare_projected_qkv
+    main = os.environ.get("C35_QK_PREP_MAIN", "0") == "1"
+
+    def _prepare_projected_qkv(self, q_proj_output, keys, values, cache, position_ids, position_embeddings, mask):
+        B, L, _ = q_proj_output.shape
+        re = self.rotary_emb
+        off = getattr(cache, "offset", None) if cache is not None else None
+        if position_ids is None:
+            pos, ok_pos = off, True
+        else:   # main model: [1, L] or [3, 1, L], read per section in the kernel (stock arithmetic for any ids)
+            pos = position_ids
+            ok_pos = main and (position_ids.shape == (1, L) or (position_ids.shape == (3, 1, L) and re.position_selector is not None))
+        if (B != 1 or L > MAX_ROWS or not ok_pos or position_embeddings is not None or isinstance(mask, mx.array)
+                or not isinstance(off, int) or self.head_dim != 256 or re.dim != 64 or not re.fused_apply
+                or re.pairing != "half_split" or self.q_norm.weight.shape[0] != 256 or self.k_norm.weight.shape[0] != 256
+                or q_proj_output.dtype != mx.bfloat16 or self.q_norm.eps != self.k_norm.eps):
+            return orig(self, q_proj_output, keys, values, cache, position_ids, position_embeddings, mask)
+        if (L, pos is off) not in _SEEN:
+            _SEEN.add((L, pos is off)); logger.info("c35 fused q/k prep engaged (%s, L=%d)", "cache offset" if pos is off else "position_ids", L)
+        hq, hk = self.num_attention_heads, self.num_key_value_heads
+        gate = mx.split(q_proj_output.reshape(B, L, hq, -1), 2, axis=-1)[1].reshape(B, L, -1)
+        queries, k = qk_prep(q_proj_output, keys, self.q_norm, self.k_norm, re.inv_freq, pos, hq, hk, 256, 32,
+                             re.position_selector if position_ids is not None and position_ids.ndim == 3 else None)
+        values = values.reshape(B, L, hk, -1).transpose(0, 2, 1, 3)
+        k, values = cache.update_and_fetch(k, values)
+        return queries, k, values, gate, mask
+
+    q35.Qwen3_5Attention._prepare_projected_qkv = _prepare_projected_qkv
+    _PATCHED = True
+    logger.info("c35 fused q/k RMSNorm + M-RoPE patch applied")
+    return True
diff --git a/omlx/patches/mlx_lm_mtp/batch_generator.py b/omlx/patches/mlx_lm_mtp/batch_generator.py
index 0eaac83..1ad29ae 100644
--- a/omlx/patches/mlx_lm_mtp/batch_generator.py
+++ b/omlx/patches/mlx_lm_mtp/batch_generator.py
@@ -64,6 +64,9 @@ def _row_exact_verify(model: Any) -> bool:
     """
     if _ROW_EXACT_DISABLED:
         return False
+    # coder35b: force row-exact verify for any model (greedy MTP == MTP-off byte for byte)
+    if os.environ.get("OMLX_MTP_ROW_EXACT_FORCE", "0").strip() == "1":
+        return True
     for candidate in (
         model,
         getattr(model, "_language_model", None),
@@ -1699,6 +1702,34 @@ def _sample_draft_with_logprobs(sampler, lp):
     return sampler(lp), _accept_lp_for(sampler, lp)
 
 
+_C35_DRAFT_COMPILE = os.environ.get("C35_DRAFT_COMPILE", "0") == "1"
+_C35_DRAFT_FNS: Dict[Any, Any] = {}
+
+
+def _c35_compiled_draft_sampler(top_k, top_p, temp):
+    """``_sample_draft_sparse`` for fixed (top_k, top_p, temp) as one mx.compile graph (global PRNG state threaded)."""
+    import mlx.core as mx
+
+    from omlx.utils.sampling import top_k_indices
+
+    def fn(lp):
+        ids = top_k_indices(lp, top_k)
+        vals = mx.take_along_axis(lp, ids, axis=-1).astype(mx.float32)
+        order = mx.argsort(-vals, axis=-1)
+        vals = mx.take_along_axis(vals, order, axis=-1)
+        ids = mx.take_along_axis(ids, order, axis=-1)
+        if 0.0 < top_p < 1.0:
+            probs = mx.exp(vals)
+            vals = mx.where(mx.cumsum(probs, axis=-1) - probs < top_p, vals, -float("inf"))
+        scaled = vals * (1.0 / temp)
+        pick = mx.random.categorical(scaled)
+        token = mx.take_along_axis(ids, pick[:, None], axis=-1).reshape(-1)
+        logq = scaled - mx.logsumexp(scaled, axis=-1, keepdims=True)
